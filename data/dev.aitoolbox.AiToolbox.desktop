[Desktop Entry]
Type=Application
Name=AI Toolbox
GenericName=AI text commands
Comment=Fix, rewrite and translate the selected text with AI
Exec=ai-toolbox
Icon=dev.aitoolbox.AiToolbox
Terminal=false
Categories=Utility;TextTools;
Keywords=ai;grammar;spelling;translate;rewrite;raycast;
StartupNotify=false
Actions=translate;settings;

[Desktop Action translate]
Name=Translate
Exec=ai-toolbox translate --empty

[Desktop Action settings]
Name=Settings
Exec=ai-toolbox settings
