# Maintainer: Erick Zanetti
pkgname=ai-toolbox-git
_pkgname=ai-toolbox
pkgver=0.1.0
pkgrel=1
pkgdesc="Raycast-style AI text commands and translator for Wayland desktops"
arch=('any')
url="https://github.com/Erick-Zanetti/ai-toolbox"
license=('MIT')
depends=('python' 'python-gobject' 'gtk4' 'libadwaita' 'wl-clipboard' 'libnotify')
makedepends=('git' 'python-build' 'python-installer' 'python-setuptools' 'python-wheel')
optdepends=(
  'claude-code: use your Claude subscription'
  'openai-codex: use your ChatGPT subscription (Codex CLI)'
  'ollama: local models'
  'wtype: paste back on wlroots compositors (Sway, niri, river)'
  'ydotool: paste back on KDE, GNOME and others'
)
provides=("$_pkgname")
conflicts=("$_pkgname")
source=("git+$url.git")
sha256sums=('SKIP')

pkgver() {
  cd "$_pkgname"
  printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

build() {
  cd "$_pkgname"
  python -m build --wheel --no-isolation
}

package() {
  cd "$_pkgname"
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 data/dev.aitoolbox.AiToolbox.desktop -t "$pkgdir/usr/share/applications"
  install -Dm644 data/dev.aitoolbox.AiToolbox.svg -t "$pkgdir/usr/share/icons/hicolor/scalable/apps"
  install -d "$pkgdir/usr/share/$_pkgname"
  cp -r examples "$pkgdir/usr/share/$_pkgname/"
  install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname"
}
